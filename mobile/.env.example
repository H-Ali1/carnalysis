# LAN address of the machine running the backend (find it with `ipconfig` or `ifconfig`).
# The phone must be on the same network, and the backend must listen on all interfaces:
#
#   uvicorn app.main:app --reload --host 0.0.0.0
#
# Restart `npx expo start` after changing this file.
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.42:8000
