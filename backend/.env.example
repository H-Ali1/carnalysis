# eBay Browse API production keys: https://developer.ebay.com/my/keys
# Leave blank to run without part pricing; responses will include a warning instead.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Origins allowed to call the API, as a JSON list. Defaults to ["*"] for local development.
# CORS_ORIGINS=["https://www.copart.co.uk"]

# Fine-tuned YOLO weights emitting `panel:damage_type` labels. Enables automatic damage
# detection from lot photos; requires `pip install -r requirements-ml.txt`.
# DAMAGE_MODEL_PATH=models/damage.pt
